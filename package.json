{
    "name": "sprocket",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.21.0",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "build": "nuxt build",
        "typecheck": "nuxt typecheck",
        "dev": "brew services start postgresql@18; nuxt dev",
        "stop": "brew services stop postgresql@18",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "start": "node .output/server/index.mjs",
        "reset-password": "pnpm dlx dotenv-cli -e .env -- node --experimental-strip-types scripts/reset-password.ts",
        "zwift-tss": "node --experimental-strip-types scripts/zwift-workout-tss.ts",
        "workout-search": "node --experimental-strip-types scripts/workout-search.ts"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.120.0",
        "@fontsource-variable/hanken-grotesk": "^5.3.0",
        "@nuxt/ui": "^4.10.0",
        "@pinia/nuxt": "^1.0.2",
        "drizzle-orm": "0.45.2",
        "fit-file-parser": "^4.1.0",
        "nuxt": "^4.5.2",
        "nuxt-auth-utils": "^0.5.30",
        "pg": "8.23.0",
        "pinia": "^4.0.3",
        "tslog": "^5.1.0",
        "vue": "^3.5.41",
        "vue-router": "^5.2.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@adonisjs/hash": "^10.1.1",
        "@iconify-json/heroicons": "^1.2.3",
        "@iconify-json/lucide": "^1.2.124",
        "@nuxt/devtools": "^3.4.1",
        "@types/node": "^26.2.0",
        "@types/pg": "^8.21.0",
        "drizzle-kit": "^0.31.10",
        "typescript": "^5.7.0",
        "vue-tsc": "^3.3.10"
    }
}
