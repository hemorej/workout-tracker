{
    "name": "sprocket",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.21.0",
    "engines": {
        "node": "26.x"
    },
    "scripts": {
        "build": "nuxt build",
        "typecheck": "nuxt typecheck",
        "dev": "brew services start postgresql@18; nuxt dev",
        "stop": "brew services stop postgresql@18",
        "generate": "nuxt generate",
        "postinstall": "nuxt prepare",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "start": "node .output/server/index.mjs",
        "reset-password": "pnpm dlx dotenv-cli -e .env -- node --experimental-strip-types scripts/reset-password.ts",
        "test": "node --experimental-strip-types --test shared/utils/zwo.test.ts shared/utils/rideMatch.test.ts shared/utils/powerBestRules.test.ts",
        "zwift-sync": "node --experimental-strip-types scripts/zwift-sync.ts",
        "zwift-activities": "node --experimental-strip-types scripts/zwift-activities.ts"
    },
    "devDependencies": {
        "@adonisjs/hash": "^10.1.1",
        "@fontsource-variable/archivo": "^5.3.0",
        "@fontsource-variable/hanken-grotesk": "^5.3.0",
        "@fontsource/instrument-serif": "^5.3.0",
        "@iconify-json/heroicons": "^1.2.3",
        "@nuxt/ui": "^4.12.0",
        "@pinia/nuxt": "^1.0.3",
        "@types/node": "^26.6.5",
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^0.31.11",
        "drizzle-orm": "0.45.4",
        "fit-file-parser": "^6.2.3",
        "nuxt": "^4.6.2",
        "nuxt-auth-utils": "^0.5.32",
        "pg": "8.23.1",
        "pinia": "^4.1.0",
        "tslog": "^5.4.0",
        "typescript": "^5.7.0",
        "vue": "^3.5.44",
        "vue-router": "^5.4.0",
        "vue-tsc": "^3.3.13",
        "zod": "^4.6.7",
        "zwift-data": "^2.1.0"
    }
}
