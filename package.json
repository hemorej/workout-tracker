{
    "name": "sprocket",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.9.0",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "build": "nuxt build",
        "typecheck": "nuxt typecheck",
        "dev": "brew services start postgresql@18; nuxt dev",
        "stop": "brew services stop postgresql@18",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "start": "node .output/server/index.mjs",
        "reset-password": "pnpm dlx dotenv-cli -e .env -- node --experimental-strip-types scripts/reset-password.ts",
        "zwift-tss": "node --experimental-strip-types scripts/zwift-workout-tss.ts",
        "workout-search": "node --experimental-strip-types scripts/workout-search.ts",
        "sync-power-bests": "pnpm dlx dotenv-cli -e .env -- node --experimental-strip-types scripts/sync-power-bests.ts"
    },
    "dependencies": {
        "@adonisjs/hash": "^10.1.0",
        "@nuxt/ui": "^4.10.0",
        "@pinia/nuxt": "^1.0.1",
        "drizzle-orm": "0.45.2",
        "nuxt": "^4.5.2",
        "nuxt-auth-utils": "^0.5.0",
        "pg": "8.22.0",
        "pinia": "^3.0.1",
        "tslog": "^5.1.0",
        "vue": "^3.5.40",
        "vue-router": "^5.2.0"
    },
    "devDependencies": {
        "@iconify-json/heroicons": "^1.2.3",
        "@nuxt/devtools": "^3.4.1",
        "@types/pg": "^8.20.4",
        "drizzle-kit": "^0.31.10",
        "typescript": "^5.7.0",
        "vue-tsc": "^3.3.8"
    }
}
