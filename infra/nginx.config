# FORGE CONFIG (DO NOT REMOVE!)
include forge-conf/3264841/before/*;
include forge-conf/3264841/sprocket.jerome-arfouche.ca/before/*;

server {
    http2 on;
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name sprocket.jerome-arfouche.ca;
    server_tokens off;
    root /home/forge/sprocket.jerome-arfouche.ca/current/.output/public;

    # FORGE SSL (DO NOT REMOVE!)
    ssl_certificate /etc/nginx/ssl/domains/1764571/3562617/server.crt;
    ssl_certificate_key /etc/nginx/ssl/domains/1764571/3562617/server.key;

    # --- Bot / scanner mitigation ---
    # Shared rules (scanner UA blocklist, WP/Joomla/IoT/admin probes, dotfile
    # drop) — canonical source: ~/Code/scripts/infra/nginx/snippets/bot-mitigation.conf
    include snippets/bot-mitigation.conf;

    # To enable rate limiting for this app, uncomment (zone already declared
    # in /etc/nginx/conf.d/rate-limits.conf):
    # limit_req zone=sprocket_api burst=40 nodelay;
    # limit_req_status 429;
    # --- End bot / scanner mitigation ---

    # --- Static asset performance ---
    # Content-hashed Nuxt build assets (JS/CSS chunks) — safe to cache for a
    # year and served from the gzip/brotli files precompressed at build time
    # by Nitro's compressPublicAssets.
    location ^~ /_nuxt/ {
        gzip_static on;
        # brotli_static on; # uncomment once the ngx_brotli module is installed
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Runtime compression for SSR-rendered HTML and API responses, which are
    # generated dynamically by Nitro and not covered by the precompressed
    # static assets above.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/css application/javascript application/json;
    # --- End static asset performance ---

    include forge-conf/3264841/site.conf;
}

# FORGE CONFIG (DO NOT REMOVE!)
include forge-conf/3264841/after/*;
include forge-conf/3264841/sprocket.jerome-arfouche.ca/after/*;
