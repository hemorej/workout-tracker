# FORGE CONFIG (DO NOT REMOVE!)
include forge-conf/3264841/before/*;
include forge-conf/3264841/sprocket.jerome-arfouche.ca/before/*;

server {
    http2 on;
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name sprocket.jerome-arfouche.ca;
    server_tokens off;
    root /home/forge/sprocket.jerome-arfouche.ca/current/.output/public;

    # FORGE SSL (DO NOT REMOVE!)
    ssl_certificate /etc/nginx/ssl/domains/1764571/3562617/server.crt;
    ssl_certificate_key /etc/nginx/ssl/domains/1764571/3562617/server.key;

    # --- Bot / scanner mitigation ---
    # NOTE: To enable rate limiting, add this to the http{} block in /etc/nginx/nginx.conf:
    #   limit_req_zone $binary_remote_addr zone=general:10m rate=20r/m;
    # Then uncomment the line below:
    # limit_req zone=general burst=40 nodelay;

    # Drop connections from known scanner user agents
    if ($http_user_agent ~* "(zgrab|masscan|l9scan|leakix|CVE-|CyberConvoy|RecordedFuture|Go-http-client)") {
        return 444;
    }
    if ($http_user_agent = "") {
        return 444;
    }

    # WordPress / WP REST API probing — this site does not run WordPress
    location ~* ^/(wp-admin|wp-content|wp-includes|wp-json|wp-login\.php|wp-config\.php|xmlrpc\.php|wlwmanifest\.xml) {
        return 444;
    }

    # Joomla probing
    location ~* ^/(plugins/|administrator/|components/) {
        return 444;
    }

    # IoT / network device CVE probes (Hikvision, D-Link, QNAP, etc.)
    location ~* ^/(SDK/|HNAP1/|cgi-bin/|ssi\.cgi|partymgr/) {
        return 444;
    }

    # Exposed admin / debug endpoints
    location ~* ^/(actuator/|telescope/|solr/|zabbix/|jasperserver|debug/|manager/html) {
        return 444;
    }

    # Drop dotfiles silently
    location ~ /\.(?!well-known).* {
        return 444;
    }
    # --- End bot / scanner mitigation ---

    # --- Static asset performance ---
    # Content-hashed Nuxt build assets (JS/CSS chunks) — safe to cache for a
    # year and served from the gzip/brotli files precompressed at build time
    # by Nitro's compressPublicAssets.
    location ^~ /_nuxt/ {
        gzip_static on;
        # brotli_static on; # uncomment once the ngx_brotli module is installed
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Runtime compression for SSR-rendered HTML and API responses, which are
    # generated dynamically by Nitro and not covered by the precompressed
    # static assets above.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/html text/css application/javascript application/json;
    # --- End static asset performance ---

    include forge-conf/3264841/site.conf;
}

# FORGE CONFIG (DO NOT REMOVE!)
include forge-conf/3264841/after/*;
include forge-conf/3264841/sprocket.jerome-arfouche.ca/after/*;
