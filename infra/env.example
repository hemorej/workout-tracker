# Names of the variables in /home/forge/sprocket.jerome-arfouche.ca/.env (values omitted).
# See the repo's .env.example and CLAUDE.md for what each one does.
DATABASE_URL=
NUXT_SESSION_PASSWORD=
PORT=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
NUXT_STRAVA_CLIENT_ID=
NUXT_STRAVA_CLIENT_SECRET=
NUXT_STRAVA_REFRESH_TOKEN=
NUXT_WAHOO_CLIENT_ID=
NUXT_WAHOO_CLIENT_SECRET=
WAHOO_REFRESH_TOKEN=
NUXT_WAHOO_WEBHOOK_TOKEN=
