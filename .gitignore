# ── Environment variables ────────────────────────────────────────────────────
# NEVER commit secrets. Copy .env.example and fill in locally.
.env
.env.*
!.env.example
scripts/.trainerroad-session
scripts/.trainerroad-credentials

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ── Nuxt ─────────────────────────────────────────────────────────────────────
# Build artefacts and Nuxt-generated files
.nuxt/
.output/

# Nuxt data dir (used by some storage/cache modules)
.data/

# Static generation output
dist/

# ── Vite / build tool cache ───────────────────────────────────────────────────
node_modules/.cache/
node_modules/.vite/

# ── Drizzle ──────────────────────────────────────────────────────────────────
# Keep: drizzle/ migration SQL files (these are intentional, versioned history)
# Ignore: Drizzle Studio's local metadata cache
drizzle/.drizzle/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Runtime / temp files ─────────────────────────────────────────────────────
*.pid
*.seed
*.pid.lock
.cache/

# ── TypeScript ────────────────────────────────────────────────────────────────
# tsconfig.json extends .nuxt/tsconfig.json which is auto-generated
# The root tsconfig.json itself should be committed — only ignore compiled output
*.tsbuildinfo

# ── Testing ──────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Package manager lock files ────────────────────────────────────────────────
# Commit whichever one your team uses; ignore the others to avoid conflicts.
# Uncomment the lines for lock files you DON'T use:
# package-lock.json   # if using yarn or pnpm
# yarn.lock           # if using npm or pnpm
# pnpm-lock.yaml      # if using npm or yarn

# ── OS generated files ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── Editor and IDE ────────────────────────────────────────────────────────────
# VS Code — ignore personal settings, keep shared workspace config if any
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains (WebStorm, IntelliJ…)
.idea/

# Vim / Neovim
*.swp
*.swo
*~
.vim/

# Sublime Text
*.sublime-project
*.sublime-workspace

# ── Misc ──────────────────────────────────────────────────────────────────────
# Compressed files that shouldn't end up in the repo
*.zip
*.tar.gz
*.tgz
