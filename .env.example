# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://postgres:password@localhost:5432/workout_tracker"

# Session encryption secret — must be at least 32 characters long.
# Generate one with: openssl rand -base64 32
NUXT_SESSION_PASSWORD="change-me-to-a-random-32-char-secret-value!!"
# Path to the pnpm binary — only consumed by infra/forge_deploy.sh (Forge
# provides it on deploy); not needed for local development.
PNPM_PATH=

# Strava API access (single-user; acquired via a one-time manual OAuth
# exchange — see CLAUDE.md "Strava API" for setup instructions).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Wahoo Cloud API access (single-user; acquired via a one-time manual OAuth
# exchange — see CLAUDE.md "Wahoo Cloud API" for setup instructions). Prod and
# local use separate Wahoo app registrations. The unprefixed WAHOO_* names
# (as in CLAUDE.md) are equivalent: nuxt.config.ts reads those at build/dev time
# and Nuxt maps the NUXT_-prefixed form onto the same runtimeConfig keys.
# Note: Wahoo rotates the refresh token on every use — this value is only a
# bootstrap fallback for a brand new install with no wahoo_tokens DB row yet.
NUXT_WAHOO_CLIENT_ID=
NUXT_WAHOO_CLIENT_SECRET=
NUXT_WAHOO_REFRESH_TOKEN=

# Shared secret authenticating the public Wahoo webhook endpoint
# (server/api/wahoo/webhook.post.ts). Must equal the `webhook_token` set on
# the Wahoo webhook subscription. Generate with: openssl rand -hex 32
NUXT_WAHOO_WEBHOOK_TOKEN=

# Directory where the webhook persists raw Wahoo FIT files. Leave blank in dev
# (defaults to .data/fit-files, gitignored). In production set an ABSOLUTE path
# OUTSIDE the Forge release dir so the files survive deploys and accumulate:
#   /home/forge/sprocket.jerome-arfouche.ca/storage/fit-files
NUXT_FIT_STORAGE_DIR=

# Optional — pin the webhook's target user by email. When unset the webhook
# resolves the sole users row (single-user app).
NUXT_WEBHOOK_USER_EMAIL=

# Anthropic API access — used by the AI coach (server/api/coach/*: workout
# generation, plan suggestion, block-progression parsing). Static key, no
# rotation needed.
ANTHROPIC_API_KEY=

# Shared secret authenticating POST /api/segments/reconcile — the nightly
# tracked-segments safety net, hit by a Forge scheduled job. Leave blank in
# dev (the reconcile endpoint just isn't callable). Generate with:
#   openssl rand -hex 32
NUXT_SEGMENTS_SYNC_TOKEN=

# Shared secret authenticating the local Zwift-folder sync daemon
# (scripts/zwift-sync.ts → POST /api/zwift/sync). Unset ⇒ the endpoints always
# return 401. Use the same value in the daemon's ZWIFT_SYNC_TOKEN. Generate with:
#   openssl rand -hex 32
NUXT_ZWIFT_SYNC_TOKEN=

# Shared secret authenticating the local Zwift-activities daemon
# (scripts/zwift-activities.ts → POST /api/zwift/activity), which uploads
# finished Zwift FIT files to be logged as workouts. Separate from the token
# above on purpose. Unset ⇒ the endpoint always returns 401. Use the same value
# in the daemon's ZWIFT_ACTIVITY_TOKEN. Generate with: openssl rand -hex 32
NUXT_ZWIFT_ACTIVITY_TOKEN=

# App log verbosity (optional; silly|trace|debug|info|warn|error|fatal, default "info")
LOG_LEVEL=
